# 1Password secret references for scripts/call_api.py. Safe to commit: these are pointers,
# not secrets. `op run --env-file op.env -- <command>` resolves them into env variables.
WARSAW_API_URL="op://Private/warsaw client private key/api_url"
WARSAW_CLIENT_ID="op://Private/warsaw client private key/client_id"
WARSAW_CLIENT_PRIVATE_KEY="op://Private/warsaw client private key/client_private.pem"
